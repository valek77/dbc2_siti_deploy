<!DOCTYPE html>
<html lang="it">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Rekonnect - Riconnettiti con l'Efficienza</title>
  <!-- Google Fonts Poppins -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
  <!-- FontAwesome per le icone -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <link rel="stylesheet" href="style.css">
</head>
<body>

  <!-- Header -->
  <header class="site-header">
    <div class="header-container">
      <a href="index.html" class="logo-container">
        <!-- Logo vettoriale caricato -->
        <img src="Rekonnect.png" alt="Rekonnect Logo" class="logo-img">
      </a>

      <!-- Hamburger Menu Mobile -->
      <button class="mobile-nav-toggle" aria-label="Menu">
        <span></span>
        <span></span>
        <span></span>
      </button>

      <nav class="nav-menu">
        <ul class="nav-list">
          <li><a href="chi-siamo.html" class="nav-item">CHI SIAMO</a></li>
          <li><a href="tariffe.html" class="nav-item">TARIFFE</a></li>
          <li><a href="contatti.html" class="nav-item">CONTATTI</a></li>
        </ul>
      </nav>

      <div class="header-actions">
        <a href="#" class="btn-customer-area">AREA CLIENTI</a>
      </div>
    </div>
  </header>

  <main>
    <!-- 1. Hero Section ad Alto Impatto -->
    <section class="hero-premium">
      <div class="hero-background">
        <!-- Immagine di background: Tecnologia Smart Energy / Transizione -->
        <div class="hero-bg-image" style="background-image: url('https://images.unsplash.com/photo-1497435334941-8c899ee9e8e9?q=80&w=1974&auto=format&fit=crop');"></div>
        <div class="hero-overlay"></div>
      </div>
      <div class="hero-content">
        <span class="badge-innovazione">L'Energia di Domani, Oggi</span>
        <h1 class="hero-title">Riconnettiti con l'Efficienza.</h1>
        <p class="hero-subtitle">Soluzioni energetiche intelligenti, trasparenti e sostenibili per la tua casa e il tuo business. Uniamo tecnologia e convenienza per guidarti nella transizione.</p>
        <div class="hero-actions">
          <a href="tariffe.html" class="btn-primary">Scopri le Soluzioni</a>
          <a href="contatti.html" class="btn-secondary">Richiedi Consulenza</a>
        </div>
      </div>
    </section>

    <!-- 2. Social Proof / Numeri Chiave -->
    <section class="social-proof-bar">
      <div class="section-container proof-grid">
        <div class="proof-item">
          <span class="proof-number">100%</span>
          <span class="proof-label">Energia Green</span>
        </div>
        <div class="proof-item">
          <span class="proof-number">Zero</span>
          <span class="proof-label">Costi Nascosti</span>
        </div>
        <div class="proof-item">
          <span class="proof-number">24/7</span>
          <span class="proof-label">Assistenza Dedicata</span>
        </div>
      </div>
    </section>

    <!-- Offerte in evidenza (Semplice Gas & Luce) -->
    <section class="solutions-section">
      <div class="section-container">
        <div style="display:flex;flex-direction:column;align-items:center;gap:10px;margin-bottom:10px;">
          <span style="font-size:13px;font-weight:600;text-transform:uppercase;letter-spacing:1px;color:var(--text-muted);">In partnership con Semplice Gas & Luce</span>
        </div>
        <h2 class="section-title">Offerte in evidenza</h2>
        <div class="solutions-grid">
          <div class="solution-card" style="display:flex;flex-direction:column;text-align:left;">
            <div class="card-icon"><i class="fa-solid fa-lightbulb"></i></div>
            <span style="display:inline-block;align-self:flex-start;background:rgba(255,122,0,0.1);color:var(--primary-brand);padding:4px 12px;border-radius:100px;font-weight:600;font-size:12px;margin-bottom:12px;">Domestico</span>
            <h3>Solo Web - Variabile PUN</h3>
            <p style="font-size:15px;">Prezzo indicizzato al PUN Index GME con spread fisso per 12 mesi.</p>
            <div style="font-size:22px;font-weight:700;color:var(--primary-brand);margin:8px 0 2px;">PUN + 0,055 €/kWh</div>
            <div style="font-size:13px;color:var(--text-muted);margin-bottom:14px;">456 €/POD/anno</div>
            <ul class="values-list" style="margin:0 0 18px;"><li><i class="fa-solid fa-check"></i> <span>1,00 € sconto bolletta via e-mail</span></li><li><i class="fa-solid fa-check"></i> <span>1,00 € sconto addebito SDD</span></li></ul>
            <a href="tariffe.html" class="btn-text" style="margin-top:auto;">Scopri di più &rarr;</a>
          </div>
          <div class="solution-card" style="display:flex;flex-direction:column;text-align:left;">
            <div class="card-icon"><i class="fa-solid fa-fire-flame-simple"></i></div>
            <span style="display:inline-block;align-self:flex-start;background:rgba(255,122,0,0.1);color:var(--primary-brand);padding:4px 12px;border-radius:100px;font-weight:600;font-size:12px;margin-bottom:12px;">Domestico</span>
            <h3>Solo Web - Variabile PSV</h3>
            <p style="font-size:15px;">Prezzo all'ingrosso indicizzato all'indice PSV Day Ahead, aggiornato mensilmente.</p>
            <div style="font-size:22px;font-weight:700;color:var(--primary-brand);margin:8px 0 2px;">PSV + 0,45 €/Smc</div>
            <div style="font-size:13px;color:var(--text-muted);margin-bottom:14px;">648 €/PDR/anno</div>
            <ul class="values-list" style="margin:0 0 18px;"><li><i class="fa-solid fa-check"></i> <span>1,00 € sconto bolletta via e-mail</span></li><li><i class="fa-solid fa-check"></i> <span>1,00 € sconto addebito SDD</span></li></ul>
            <a href="tariffe.html" class="btn-text" style="margin-top:auto;">Scopri di più &rarr;</a>
          </div>
          <div class="solution-card" style="display:flex;flex-direction:column;text-align:left;">
            <div class="card-icon"><i class="fa-solid fa-lightbulb"></i></div>
            <span style="display:inline-block;align-self:flex-start;background:rgba(255,122,0,0.1);color:var(--primary-brand);padding:4px 12px;border-radius:100px;font-weight:600;font-size:12px;margin-bottom:12px;">Con Logicard Casa</span>
            <h3>Solo Web - Variabile PUN Logicard Casa</h3>
            <p style="font-size:15px;">Indicizzata al PUN Index GME con carta Logicard Casa (contributo 168 €+IVA/anno).</p>
            <div style="font-size:22px;font-weight:700;color:var(--primary-brand);margin:8px 0 2px;">PUN + 0,05 €/kWh</div>
            <div style="font-size:13px;color:var(--text-muted);margin-bottom:14px;">456 €/POD/anno</div>
            <ul class="values-list" style="margin:0 0 18px;"><li><i class="fa-solid fa-check"></i> <span>1,00 € sconto bolletta via e-mail</span></li><li><i class="fa-solid fa-check"></i> <span>1,00 € sconto addebito SDD</span></li></ul>
            <a href="tariffe.html" class="btn-text" style="margin-top:auto;">Scopri di più &rarr;</a>
          </div>
        </div>
        <div style="text-align:center;margin-top:40px;">
          <a href="tariffe.html" class="btn-primary">Vedi tutte le offerte</a>
        </div>
      </div>
    </section>

    <!-- 3. Griglia Servizi/Soluzioni (Card Design Moderno) -->
    <section class="solutions-section">
      <div class="section-container">
        <h2 class="section-title">Le nostre soluzioni per te</h2>
        <div class="solutions-grid">
          <a href="tariffe.html" class="solution-card">
            <div class="card-icon"><i class="fa-solid fa-leaf"></i></div>
            <h3>Efficientamento Energetico</h3>
            <p>Riduci i consumi e ottimizza la resa energetica con le nostre tecnologie smart.</p>
            <span class="btn-text">Scopri di più &rarr;</span>
          </a>
          <a href="tariffe.html" class="solution-card">
            <div class="card-icon"><i class="fa-solid fa-solar-panel"></i></div>
            <h3>Consulenza Solare</h3>
            <p>Progettazione e installazione di impianti fotovoltaici su misura per il tuo risparmio.</p>
            <span class="btn-text">Scopri di più &rarr;</span>
          </a>
          <a href="tariffe.html" class="solution-card">
            <div class="card-icon"><i class="fa-solid fa-chart-line"></i></div>
            <h3>Monitoraggio Consumi</h3>
            <p>Tieni tutto sotto controllo in tempo reale tramite la nostra piattaforma digitale.</p>
            <span class="btn-text">Scopri di più &rarr;</span>
          </a>
        </div>
      </div>
    </section>

    <!-- 4. Sezione Valori / Sostenibilità -->
    <section class="values-split">
      <div class="section-container split-grid">
        <div class="values-text">
          <h2>Sostenibilità come tecnologia.</h2>
          <p>In <strong>Rekonnect</strong> crediamo che la vera transizione ecologica passi attraverso l'innovazione tecnologica. Uniamo tariffe trasparenti a sistemi di ottimizzazione dei consumi all'avanguardia.</p>
          <ul class="values-list">
            <li><i class="fa-solid fa-check"></i> <span>Impronta Carbon Neutral certificata</span></li>
            <li><i class="fa-solid fa-check"></i> <span>Bolletta Trasparente Digitale e chiara</span></li>
            <li><i class="fa-solid fa-check"></i> <span>Tecnologie Smart Home integrate</span></li>
          </ul>
          <a href="chi-siamo.html" class="btn-primary" style="margin-top: 20px;">Scopri i nostri valori</a>
        </div>
        <div class="values-image">
          <div class="img-wrapper">
            <img src="https://images.unsplash.com/photo-1497440001374-f26997328c1b?q=80&w=1932&auto=format&fit=crop" alt="Sostenibilità Rekonnect">
          </div>
        </div>
      </div>
    </section>
  </main>

  <!-- Footer -->
  <footer class="site-footer">
    <!-- Upper Footer -->
    <div class="upper-footer">
      <div class="section-container footer-grid">
        <div class="footer-col brand-col">
          <div class="footer-logo">
            <img src="rekonnect_b.png" alt="Rekonnect Logo" class="footer-logo-img">
          </div>
          <p class="brand-desc">Rekonnect S.r.l. - Soluzioni energetiche all'avanguardia per l'efficienza, la trasparenza e la sostenibilità.</p>
          <div class="social-links">
            <a href="#"><i class="fa-brands fa-facebook-f"></i></a>
            <a href="#"><i class="fa-brands fa-instagram"></i></a>
            <a href="#"><i class="fa-brands fa-linkedin-in"></i></a>
          </div>
        </div>

        <div class="footer-col">
          <h4 class="footer-col-title">OFFERTE E SERVIZI</h4>
          <ul class="footer-links-list">
            <li><a href="tariffe.html">Offerte Luce</a></li>
            <li><a href="tariffe.html">Offerte Gas</a></li>
            <li><a href="tariffe.html">Efficientamento</a></li>
          </ul>
        </div>

        <div class="footer-col">
          <h4 class="footer-col-title">AZIENDA</h4>
          <ul class="footer-links-list">
            <li><a href="chi-siamo.html">Chi Siamo</a></li>
            <li><a href="tariffe.html">Tariffe</a></li>
            <li><a href="contatti.html">Contatti</a></li>
          </ul>
        </div>

        <div class="footer-col">
          <h4 class="footer-col-title">LEGALE</h4>
          <ul class="footer-links-list">
            <li><a href="privacy-policy.html">Privacy Policy</a></li>
            <li><a href="condizioni-utilizzo.html">Condizioni Generali</a></li>
          </ul>
        </div>
      </div>
    </div>

    <!-- Lower Footer -->
    <div class="lower-footer">
      <div class="section-container lower-footer-container">
        <p class="company-credentials">&copy; 2026 REKONNECT S.R.L. - Sede Legale: Via Florindo Ferro 49, 80027 Frattamaggiore (NA) - P.IVA e C.F.: 10052141214 - R.E.A.: NA - 1077010 - Capitale Sociale &euro; 10.000,00 i.v. - PEC: rekonnectsrl0024@pec.it</p>
      </div>
    </div>
  </footer>

  <!-- Widget Flottante Sticky -->
  <div class="floating-widget">
    <a href="contatti.html" class="sticky-contact-btn">
      <i class="fa-solid fa-bolt"></i>
      <span>Riconnettiti Subito</span>
    </a>
  </div>

  <script>
    // Effetto sticky all'header in base allo scroll
    window.addEventListener('scroll', () => {
      const header = document.querySelector('.site-header');
      if (window.scrollY > 50) {
        header.classList.add('scrolled');
      } else {
        header.classList.remove('scrolled');
      }
    });

    // Toggle navigazione mobile (Hamburger)
    const mobileNavToggle = document.querySelector('.mobile-nav-toggle');
    const navMenu = document.querySelector('.nav-menu');

    mobileNavToggle.addEventListener('click', () => {
      mobileNavToggle.classList.toggle('active');
      navMenu.classList.toggle('active');
    });
  </script>
</body>
</html>