  <title>Perfect Mood - L'Energia per il tuo comfort</title>
  <link
    href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;600;700;800&family=Inter:wght@400;500;600&display=swap"
    rel="stylesheet">
  <link rel="stylesheet" href="style.css">
</head>

<body>

  <header class="main-header">
    <div class="header-container">
      <a href="index.html" class="logo">
        <img src="perfect_mood.png" alt="Perfect Mood - Energia" class="logo-img">
      </a>
      <nav class="nav-links">
        <a href="chi-siamo.html" class="nav-link">Chi Siamo</a>
        <a href="tariffe.html" class="nav-link">Servizi & Tariffe</a>
        <a href="contatti.html" class="nav-link">Contatti</a>
      </nav>
      <a href="contatti.html" class="btn-header">Richiedi Consulenza</a>
    </div>
  </header>

  <main>
    <!-- HERO ASIMMETRICA -->
    <section class="hero-split">
      <div class="hero-text-side">
        <div class="pill-badge">L'innovazione nell'energia</div>
        <h1>Entra nel tuo<br><span class="text-gradient">Perfect Mood.</span></h1>
        <p>Soluzioni energetiche, efficientamento e consulenza per aziende e privati. Elimina lo stress delle utenze, ottimizza i consumi e abbraccia la transizione sostenibile.</p>
        <div class="hero-actions">
          <a href="tariffe.html" class="btn-primary">Scopri le Soluzioni</a>
        </div>
      </div>
      <div class="hero-visual-side">
        <div class="visual-wrapper" id="hero-mini-slider">
          <!-- Slide Images -->
          <img src="slide_1.jpg" alt="Sede Corporate" class="hero-img hero-slide active">
          <img src="slide_2.jpg" alt="Energia Sostenibile" class="hero-img hero-slide">
          <img src="slide_3.jpg" alt="Smart City" class="hero-img hero-slide">
          
          <div class="floating-card">
            <span class="card-icon">⚡</span>
            <div class="card-data">
              <strong>Fino al 30%</strong>
              <span>Risparmio Energetico</span>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- MARQUEE SCORREVOLE -->
    <div class="marquee-section">
      <div class="marquee-content">
        <span>TRANSIZIONE ENERGETICA</span> <span>•</span>
        <span>EFFICIENZA AZIENDALE</span> <span>•</span>
        <span>FORNITURE GREEN</span> <span>•</span>
        <span>CONSULENZA SU MISURA</span> <span>•</span>
        <span>TRANSIZIONE ENERGETICA</span> <span>•</span>
        <span>EFFICIENZA AZIENDALE</span> <span>•</span>
        <span>FORNITURE GREEN</span> <span>•</span>
        <span>CONSULENZA SU MISURA</span>
      </div>
    </div>

    <!-- BENTO GRID FEATURES -->
    <section class="bento-section">
      <div class="section-header">
        <h2>Un ecosistema energetico pensato per te</h2>
        <p>Approccio B2B e B2C per guidarti verso il massimo del risparmio.</p>
      </div>
      
      <div class="bento-grid">
        <div class="bento-item bento-large">
          <div class="bento-content">
