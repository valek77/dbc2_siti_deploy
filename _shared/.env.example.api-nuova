# ============================================================================
# ESEMPIO .env  —  API NUOVA  (/landing-pages/{LANDING_PAGE_ID})
# ----------------------------------------------------------------------------
# COPIARE questo file come ".env" NELLA CARTELLA DEL SITO (non in _shared/) e
# compilare i valori reali. Il file ".env" NON va su git (contiene il token).
# ============================================================================

# Indirizzo base dell'API Datalia (di norma non cambia)
DBC2_API_BASE=https://dbc2.datalia.it/api

# Token bearer fornito da Datalia (SEGRETO). In alternativa puoi metterlo come
# variabile di sistema (PHP-FPM env[] / Apache SetEnv) e ometterlo qui.
DBC2_TOKEN=incolla-qui-il-token

# ID della landing page (numero) -> seleziona l'API NUOVA. Es. 42
# Se valorizzato, ha la PRECEDENZA su COMPANY_ID.
LANDING_PAGE_ID=

# NOTA: con l'API nuova NON servono SITO_WEB né OPERATORE_ENERGETICO: l'URL del
# sito e i dati dell'operatore arrivano direttamente dall'API
# ($LANDING_PAGE['url'], $OPERATORE['nome_marketing'], ...). Puoi comunque
# aggiungerli qui se qualche pagina li usa ancora come stringa.
