# Esempio di _shared/.env per il TOOL DI AUDIT (_shared/audit.php).
#
# Copia questo file in _shared/.env e inserisci il token reale. Il file
# _shared/.env è IGNORATO da git (vedi .gitignore): il token non finirà mai
# in un commit. Lo legge SOLO audit.php; il runtime dei siti (config.php)
# continua a prendere il token dall'ambiente di sistema del server.
#
# In alternativa, senza creare questo file, esporta le variabili nell'ambiente:
#   PowerShell:  $env:DBC2_TOKEN="2|xxxx"; php _shared/audit.php
#   bash:        DBC2_TOKEN="2|xxxx" php _shared/audit.php

DBC2_TOKEN=2|incolla-qui-il-token
DBC2_API_BASE=https://dbc2.datalia.it/api
