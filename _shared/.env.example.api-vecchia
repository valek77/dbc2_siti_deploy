# ============================================================================
# ESEMPIO .env  —  API VECCHIA  (/companies/{COMPANY_ID})   [DEPRECATA, attiva]
# ----------------------------------------------------------------------------
# COPIARE questo file come ".env" NELLA CARTELLA DEL SITO (non in _shared/) e
# compilare i valori reali. Il file ".env" NON va su git (contiene il token).
# ============================================================================

# Indirizzo base dell'API Datalia (di norma non cambia)
DBC2_API_BASE=https://dbc2.datalia.it/api

# Token bearer fornito da Datalia (SEGRETO). In alternativa puoi metterlo come
# variabile di sistema (PHP-FPM env[] / Apache SetEnv) e ometterlo qui.
DBC2_TOKEN=incolla-qui-il-token

# ID azienda (numero) -> seleziona l'API VECCHIA. Es. 32
COMPANY_ID=

# Dominio del sito mostrato nei testi legali (senza http). Es. www.gowin-srl.it
SITO_WEB=

# Operatore energetico di cui il sito è rivenditore. Es. Hera Comm
OPERATORE_ENERGETICO=
