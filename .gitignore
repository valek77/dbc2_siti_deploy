# File di configurazione con segreti (token API): mai su git.


# Cache locale dei dati azienda scaricati dall'API.
.company-cache.json
**/.company-cache.json
# Marcatore "API fallita di recente" e file temporanei della scrittura atomica.
**/.company-cache.json.*
**/.dbc2*
.claude/

# Cache e report del tool di audit (_shared/audit.php).
_shared/.audit-api-cache.json
_shared/audit-report.json
_shared/audit-report.html

# .env condiviso SOLO per il tool di audit: può contenere il TOKEN -> mai su git.
# (I .env per-sito restano versionati: contengono solo LANDING_PAGE_ID/COMPANY_ID.)
_shared/.env
.vscode/
