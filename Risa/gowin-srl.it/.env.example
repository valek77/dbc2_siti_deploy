# Configurazione del sito - COPIARE questo file in ".env" e compilare i valori reali.
# Il file ".env" NON va caricato su git (contiene il token segreto).

# Indirizzo base dell'API Datalia (di norma non cambia)
DBC2_API_BASE=https://dbc2.datalia.it/api

# Token bearer fornito da Datalia per leggere i dati azienda (SEGRETO)
DBC2_TOKEN=incolla-qui-il-token

# ID dell'azienda di questo sito (numero), es. 1
COMPANY_ID=

# Indirizzo del sito web mostrato nei testi legali (senza http), es. www.gowin-srl.it
SITO_WEB=www.gowin-srl.it

# Operatore energetico di cui il sito è rivenditore, es. Hera Comm
OPERATORE_ENERGETICO=Hera Comm
